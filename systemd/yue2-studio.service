# Music Studio + radio. Copy to /etc/systemd/system/, replace YOURUSER and paths, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now yue2-studio
[Unit]
Description=YuE2 Music Studio + radio (web UI + GPU queue) on port 7860
After=network-online.target vllm.service
Wants=network-online.target

[Service]
User=YOURUSER
Group=YOURUSER
SupplementaryGroups=render video
WorkingDirectory=/home/YOURUSER/yue2-xpu-radio/studio
Environment=STUDIO_PORT=7860
# one YuE2 worker process per GPU
Environment=STUDIO_DEVICES=xpu:0,xpu:1
# the LLM service the studio pauses while it needs the GPUs (and restarts afterwards)
Environment=STUDIO_LLM_UNIT=vllm.service
# OpenAI-compatible songwriter/lyrics LLMs, tried in order; put one on another machine first-fallback
Environment="STUDIO_LYRICS_LLMS=http://localhost:8000/v1|qwen38|local LLM,http://other-host:8001/v1|qwen38|LLM server 2"
# 0 = keep the GPUs until someone presses "Give GPUs back" (or the radio is switched off)
Environment=STUDIO_RETURN_MINUTES=0
Environment=STUDIO_DATA=/home/YOURUSER/yue2-xpu-radio/library
Environment=STUDIO_INSTRUMENTAL=/home/YOURUSER/YuE/skills/yue2-music/instrumental/scripts
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/YOURUSER/venv-yue2/bin/python /home/YOURUSER/yue2-xpu-radio/studio/app.py
Restart=on-failure
RestartSec=10
# no NoNewPrivileges: the studio uses sudo to pause/resume the LLM service

[Install]
WantedBy=multi-user.target
